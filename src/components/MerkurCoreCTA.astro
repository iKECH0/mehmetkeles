---
// MerkurCoreCTA.astro
---
<section class="relative overflow-hidden py-16 sm:py-24">
  
  <div class="container-x relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 max-w-[90rem] mx-auto">
      
      <!-- Card 1: Merkür Odak -->
      <div class="rounded-[2rem] bg-slate-950 border border-slate-800 p-8 text-center shadow-[0_20px_50px_-12px_rgba(8,145,178,0.2)] relative overflow-hidden group flex flex-col justify-between h-full">
        
        <!-- Backgrounds -->
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[300px] h-[300px] rounded-full bg-brand-500/20 blur-[80px] pointer-events-none transition-transform duration-700 group-hover:scale-110"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/3 w-[250px] h-[250px] rounded-full bg-brand-400/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20 pointer-events-none"></div>

        <div>
          <!-- Badge -->
          <div class="inline-flex relative z-10 items-center gap-2 rounded-full border border-brand-400/40 bg-brand-950/50 px-4 py-1.5 text-xs font-semibold text-brand-300 backdrop-blur-md mb-6 animate-fade-up shadow-[0_0_15px_rgba(34,211,238,0.2)]">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
            </span>
            Merkür Odak
          </div>

          <!-- Headings -->
          <h2 class="relative z-10 text-2xl sm:text-3xl font-display font-bold leading-[1.2] tracking-tight text-white mb-6 animate-fade-up" style="animation-delay: 100ms;">
            Akıllı Okuma ve <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-brand-200 to-brand-500 drop-shadow-sm">Bilişsel Gelişim Sistemi</span>
          </h2>

          <div class="relative z-10 inline-block rounded-xl bg-white/5 px-5 py-2.5 border border-white/10 mb-6 animate-fade-up" style="animation-delay: 200ms;">
            <p class="text-sm sm:text-base font-display font-semibold text-slate-200 tracking-wide">
              "Odaklan, Düşün, Anla, Kazan."
            </p>
          </div>

          <p class="relative z-10 text-sm sm:text-base text-slate-300 leading-relaxed mx-auto mb-8 animate-fade-up" style="animation-delay: 300ms;">
            Göz kaslarını eğit, kelime dağarcığını genişlet ve anlama oranını düşürmeden okuma hızını <span class="text-white font-bold">en az 3 katına</span> çıkar. 30 günlük özel kamp seni bekliyor.
          </p>
        </div>

        <!-- CTA Button -->
        <div class="relative z-10 animate-fade-up mt-auto" style="animation-delay: 400ms;">
          <a href="https://merkurodak.com.tr/" target="_blank" rel="noopener noreferrer" class="group/btn overflow-hidden relative flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-brand-500 to-brand-600 px-6 py-3.5 text-sm font-bold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(6,182,212,0.5)] w-full">
            <span class="relative z-10 flex items-center gap-2">
              Odak'lan ve Başla
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/btn:translate-x-1"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <div class="absolute inset-0 rounded-full border-2 border-white/20 z-10 transition-colors group-hover/btn:border-white/40"></div>
            <div class="absolute inset-0 -translate-x-full rounded-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-1000 group-hover/btn:animate-[shimmer_1.5s_infinite]"></div>
          </a>
        </div>
      </div>

      <!-- Card 2: Merkür Yörünge -->
      <div class="rounded-[2rem] bg-slate-950 border border-slate-800 p-8 text-center shadow-[0_20px_50px_-12px_rgba(245,158,11,0.2)] relative overflow-hidden group flex flex-col justify-between h-full">
        
        <!-- Backgrounds -->
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[300px] h-[300px] rounded-full bg-accent-500/20 blur-[80px] pointer-events-none transition-transform duration-700 group-hover:scale-110"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/3 w-[250px] h-[250px] rounded-full bg-accent-400/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20 pointer-events-none"></div>

        <div>
          <!-- Badge -->
          <div class="inline-flex relative z-10 items-center gap-2 rounded-full border border-accent-400/40 bg-accent-950/50 px-4 py-1.5 text-xs font-semibold text-accent-300 backdrop-blur-md mb-6 animate-fade-up shadow-[0_0_15px_rgba(245,158,11,0.2)]" style="animation-delay: 100ms;">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-500"></span>
            </span>
            Merkür Yörünge
          </div>

          <!-- Headings -->
          <h2 class="relative z-10 text-2xl sm:text-3xl font-display font-bold leading-[1.2] tracking-tight text-white mb-6 animate-fade-up" style="animation-delay: 200ms;">
            Öğrenci Takip <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 via-accent-200 to-accent-500 drop-shadow-sm">Platformu</span>
          </h2>

          <div class="relative z-10 inline-block rounded-xl bg-white/5 px-5 py-2.5 border border-white/10 mb-6 animate-fade-up" style="animation-delay: 300ms;">
            <p class="text-sm sm:text-base font-display font-semibold text-slate-200 tracking-wide">
              "Planla, Takip Et, Hedefine Ulaş."
            </p>
          </div>

          <p class="relative z-10 text-sm sm:text-base text-slate-300 leading-relaxed mx-auto mb-8 animate-fade-up" style="animation-delay: 400ms;">
            Tüm eğitim süreçlerini akıllı bir asistan ile planla. Ders takibi, gelişim raporları ve hedeflerine giden yolda ihtiyacın olan her şey Yörünge'de.
          </p>
        </div>

        <!-- CTA Button -->
        <div class="relative z-10 animate-fade-up mt-auto" style="animation-delay: 500ms;">
          <a href="https://merkuryorunge.com.tr/" target="_blank" rel="noopener noreferrer" class="group/btn overflow-hidden relative flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-accent-500 to-accent-600 px-6 py-3.5 text-sm font-bold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(245,158,11,0.5)] w-full">
            <span class="relative z-10 flex items-center gap-2">
              Yörünge'ni Keşfet
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/btn:translate-x-1"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <div class="absolute inset-0 rounded-full border-2 border-white/20 z-10 transition-colors group-hover/btn:border-white/40"></div>
            <div class="absolute inset-0 -translate-x-full rounded-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-1000 group-hover/btn:animate-[shimmer_1.5s_infinite]"></div>
          </a>
        </div>
      </div>

      <!-- Card 3: Merkür Referans -->
      <div class="rounded-[2rem] bg-slate-950 border border-slate-800 p-8 text-center shadow-[0_20px_50px_-12px_rgba(168,85,247,0.2)] relative overflow-hidden group flex flex-col justify-between h-full">

        <!-- Backgrounds -->
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[300px] h-[300px] rounded-full bg-purple-500/20 blur-[80px] pointer-events-none transition-transform duration-700 group-hover:scale-110"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/3 w-[250px] h-[250px] rounded-full bg-purple-400/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20 pointer-events-none"></div>

        <div>
          <!-- Badge -->
          <div class="inline-flex relative z-10 items-center gap-2 rounded-full border border-purple-400/40 bg-purple-950/50 px-4 py-1.5 text-xs font-semibold text-purple-300 backdrop-blur-md mb-6 animate-fade-up shadow-[0_0_15px_rgba(168,85,247,0.2)]" style="animation-delay: 200ms;">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
            </span>
            Merkür Referans Sistemi
          </div>

          <!-- Headings -->
          <h2 class="relative z-10 text-2xl sm:text-3xl font-display font-bold leading-[1.2] tracking-tight text-white mb-6 animate-fade-up" style="animation-delay: 300ms;">
            Birlikte Öğreten, <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-purple-200 to-purple-500 drop-shadow-sm">Birlikte Kazanan</span>
          </h2>

          <div class="relative z-10 inline-block rounded-xl bg-white/5 px-5 py-2.5 border border-white/10 mb-6 animate-fade-up" style="animation-delay: 400ms;">
            <p class="text-sm sm:text-base font-display font-semibold text-slate-200 tracking-wide">
              "Eğitim Ağına Katıl, Kazan."
            </p>
          </div>

          <p class="relative z-10 text-sm sm:text-base text-slate-300 leading-relaxed mx-auto mb-8 animate-fade-up" style="animation-delay: 500ms;">
            Eğitime değer katarken sen de kazan. Referans sistemimizle eğitim ağına destek ol, birlikte büyümenin ayrıcalığını ve fırsatlarını yaşa.
          </p>
        </div>

        <!-- CTA Button -->
        <div class="relative z-10 animate-fade-up mt-auto" style="animation-delay: 600ms;">
          <a href="https://merkurreferans.com.tr/" target="_blank" rel="noopener noreferrer" class="group/btn overflow-hidden relative flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-3.5 text-sm font-bold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(168,85,247,0.5)] w-full">
            <span class="relative z-10 flex items-center gap-2">
              Referans'lı Ol
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/btn:translate-x-1"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <div class="absolute inset-0 rounded-full border-2 border-white/20 z-10 transition-colors group-hover/btn:border-white/40"></div>
            <div class="absolute inset-0 -translate-x-full rounded-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-1000 group-hover/btn:animate-[shimmer_1.5s_infinite]"></div>
          </a>
        </div>
      </div>
      
    </div>
  </div>
  
  <style>
    @keyframes shimmer {
      100% { transform: translateX(100%); }
    }
  </style>
</section>
