---
import TeacherApplicationForm from './react/TeacherApplicationForm.tsx';
---
<section id="ogretmen-basvuru" class="section relative overflow-hidden bg-slate-50/70">
  <div class="absolute -bottom-24 -left-12 w-80 h-80 rounded-full bg-accent-400/10 blur-3xl"></div>
  <div class="container-x relative grid lg:grid-cols-12 gap-8 lg:gap-10">
    <div class="lg:col-span-5">
      <span class="chip">Kariyer</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold">Öğretmen / Eğitmen Başvurusu</h2>
      <p class="mt-3 text-slate-600">
        Merkür Eğitim Akademisi ailesine katılmak ister misiniz? Tecrübeli, gelişime açık ve öğrenci odaklı eğitmenleri ekibimize bekliyoruz.
      </p>
      <ul class="mt-6 space-y-3 text-sm text-slate-700">
        {[
          'Branş bağımsız değerlendirme (Matematik, Fen, Türkçe, Yabancı Dil vb.)',
          'Yüz yüze ve online ders verme imkanı',
          'Adil ücretlendirme ve esnek çalışma saatleri',
        ].map((t) => (
          <li class="flex items-center gap-2">
            <span class="grid place-items-center w-5 h-5 rounded-full bg-brand-100 text-brand-700">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            {t}
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-7">
      <div class="rounded-3xl border border-slate-200 bg-white shadow-soft p-6 sm:p-8">
        <TeacherApplicationForm client:load />
      </div>
    </div>
  </div>
</section>
