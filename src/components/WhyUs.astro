---
const items = [
  { t: 'Kişiye Özel Plan', d: 'Her öğrencinin seviyesine ve hedefine göre özel çalışma takvimi.' },
  { t: 'Ölçülebilir İlerleme', d: 'Düzenli ölçme-değerlendirme raporları ile somut gelişim takibi.' },
  { t: 'Tecrübeli Eğitmen', d: '10+ yıllık matematik ve danışmanlık deneyimi.' },
  { t: 'Esnek Format', d: 'Online ve yüz yüze, birebir veya 3-4 kişilik mini gruplar.' },
  { t: 'Veli İletişimi', d: 'Düzenli geri bildirim ile aileyi sürece dahil eden iletişim.' },
  { t: 'Soru Desteği', d: 'Ders dışı zamanlarda da yanıtlanan soru desteği.' },
];
---
<section id="neden-biz" class="section bg-gradient-to-b from-white to-brand-50/40">
  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-24">
        <span class="chip">Neden Biz</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold">Sonuç odaklı, planlı, şeffaf bir eğitim deneyimi</h2>
        <p class="mt-4 text-slate-600">Birebir ilgi, somut ölçüm ve düzenli geri bildirim. Her öğrenciye değen, her veli ile iletişim kuran bir akademi.</p>
        <div class="relative mt-8 rounded-[2rem] overflow-hidden border border-slate-100 shadow-soft">
          <img src="/image3.png" alt="Birebir ders ve etüt ortamı" class="w-full h-auto object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-900/30 via-transparent to-transparent"></div>
        </div>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
        {items.map((it, i) => (
          <div class="rounded-2xl bg-white p-6 border border-slate-100 hover:shadow-soft transition">
            <div class="flex items-center gap-3">
              <span class="grid place-items-center w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-display font-bold">{(i + 1).toString().padStart(2,'0')}</span>
              <h3 class="text-lg font-semibold">{it.t}</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{it.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
