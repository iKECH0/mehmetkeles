---
import { SITE } from '../lib/constants';
---
<section id="iletisim" class="section bg-slate-50/60">
  <div class="container-x grid lg:grid-cols-2 gap-12">
    <div>
      <span class="chip">İletişim</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold">Bize ulaşın</h2>
      <p class="mt-3 text-slate-600">Sorularınız ve detaylı bilgi için doğrudan iletişime geçebilirsiniz.</p>

      <div class="mt-8 space-y-4">
        <a href={`tel:${SITE.phoneIntl}`} class="flex items-center gap-4 rounded-2xl bg-white p-5 border border-slate-100 hover:shadow-soft transition">
          <span class="grid place-items-center w-12 h-12 rounded-xl bg-brand-50 text-brand-700">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92V21a1 1 0 0 1-1.09 1A19 19 0 0 1 2 4.09 1 1 0 0 1 3 3h4.09a1 1 0 0 1 1 .75l1 4a1 1 0 0 1-.27 1L7 10.5a16 16 0 0 0 6.5 6.5l1.75-1.82a1 1 0 0 1 1-.27l4 1a1 1 0 0 1 .75 1z"/></svg>
          </span>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-500">Telefon</div>
            <div class="font-semibold text-slate-900">{SITE.phoneDisplay}</div>
          </div>
        </a>

        <a href={`https://wa.me/${SITE.whatsappNumber}`} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-2xl bg-white p-5 border border-slate-100 hover:shadow-soft transition">
          <span class="grid place-items-center w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600">
            <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor"><path d="M16.04 5.33c-5.86 0-10.62 4.76-10.62 10.62 0 1.87.49 3.7 1.42 5.31L5.33 27l5.86-1.53a10.6 10.6 0 0 0 4.85 1.16c5.86 0 10.62-4.76 10.62-10.62S21.9 5.33 16.04 5.33z"/></svg>
          </span>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-500">WhatsApp</div>
            <div class="font-semibold text-slate-900">Hemen mesaj gönderin</div>
          </div>
        </a>

          <div class="flex items-start gap-4 rounded-2xl bg-white p-5 border border-slate-100">
          <span class="grid place-items-center w-12 h-12 rounded-xl bg-accent-400/10 text-accent-600">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
          </span>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">Hizmet Bölgesi</div>
            <div class="text-sm font-semibold text-slate-700">Meram / Selçuklu / Karatay - KONYA</div>
            <div class="mt-1 text-sm text-slate-500">Tüm Türkiye'ye Online Eğitim İmkanı</div>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-3xl overflow-hidden border border-slate-100 bg-white shadow-soft min-h-[400px]">
      <iframe
        title="Merkür Eğitim Akademisi konum"
        class="w-full h-full min-h-[400px]"
        src="https://www.openstreetmap.org/export/embed.html?bbox=32.46%2C37.84%2C32.56%2C37.92&layer=mapnik&marker=37.879%2C32.493"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
