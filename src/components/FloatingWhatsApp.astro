---
import { SITE } from '../lib/constants';
const msg = encodeURIComponent('Merhaba, özel ders hakkında bilgi almak istiyorum.');
const href = `https://wa.me/${SITE.whatsappNumber}?text=${msg}`;
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp ile iletişime geç"
  class="fixed bottom-5 right-5 z-50 group"
>
  <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-60 animate-ping group-hover:opacity-0"></span>
  <span class="relative grid place-items-center w-14 h-14 rounded-full bg-emerald-500 text-white shadow-soft hover:bg-emerald-600 transition-transform group-hover:scale-105">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor" aria-hidden="true">
      <path d="M19.11 17.32c-.27-.13-1.6-.79-1.85-.88-.25-.09-.43-.13-.6.13-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.13-1.13-.42-2.16-1.33-.8-.71-1.34-1.59-1.5-1.86-.16-.27-.02-.41.12-.54.13-.13.27-.32.4-.49.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.13-.6-1.45-.83-1.99-.22-.52-.44-.45-.6-.46h-.51c-.18 0-.47.07-.72.34-.25.27-.94.92-.94 2.25 0 1.32.97 2.6 1.1 2.78.13.18 1.91 2.92 4.63 4.09.65.28 1.16.45 1.55.58.65.21 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.62.23-1.16.16-1.28-.07-.13-.25-.2-.52-.34zM16.04 5.33h-.01c-5.86 0-10.62 4.76-10.62 10.62 0 1.87.49 3.7 1.42 5.31L5.33 27l5.86-1.53a10.6 10.6 0 0 0 4.85 1.16c5.86 0 10.62-4.76 10.62-10.62S21.9 5.33 16.04 5.33z"/>
    </svg>
  </span>
  <span class="hidden sm:inline-flex absolute right-16 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-full bg-slate-900 text-white text-xs px-3 py-1.5 opacity-0 group-hover:opacity-100 transition">WhatsApp'tan yaz</span>
</a>
