---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Levels from '../components/Levels.astro';
import WhyUs from '../components/WhyUs.astro';
import ApplicationSection from '../components/ApplicationSection.astro';
import TeacherApplicationSection from '../components/TeacherApplicationSection.astro';
import Contact from '../components/Contact.astro';
import Showcase from '../components/Showcase.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import MerkurCoreCTA from '../components/MerkurCoreCTA.astro';
---
<BaseLayout>
  <Navbar />
  <main>
    <Hero />
    <MerkurCoreCTA />
    <TrustBar />
    <About />
    <Services />
    <Levels />
    <WhyUs />
    <ApplicationSection />
    <TeacherApplicationSection />
    <Contact />
    <Showcase />
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
